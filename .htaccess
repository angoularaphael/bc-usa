Options -Indexes
ServerSignature Off
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_authz_core.c>
    Require all granted
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\.git(/|$) - [F,L]
    RewriteRule ^_audit(/|$) - [F,L]
    RewriteRule \.(py|pyc|pyo|md)$ - [F,L]

    RewriteRule ^index\.html$ ./ [R=301,L]
    RewriteRule ^(disciplines|planning|clubs|nos-clubs|abonnements|contact)\.html$ $1/ [R=301,L]
    RewriteRule ^(disciplines|planning|clubs|nos-clubs|abonnements|contact)$ $1/ [R=301,L]
</IfModule>
